# TalentAI Platform — Variables de entorno
# Copiar a .env.local y completar con tus valores

# ─── REQUERIDAS ──────────────────────────────────────────────
# Supabase → Dashboard del proyecto → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# ─── OPCIONALES ──────────────────────────────────────────────
# Google Gemini (aistudio.google.com → Get API key)
VITE_GOOGLE_API_KEY=your_google_api_key_here

# HuggingFace (huggingface.co → Settings → Access Tokens)
VITE_HUGGINGFACE_TOKEN=your_huggingface_token_here
