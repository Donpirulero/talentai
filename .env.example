# TalentAI Platform Configuration

# Frontend
VITE_API_BASE_URL=http://localhost:8001

# Backend (DeepTutor Engine)
# ==========================
# LLM Provider (openai, azure_openai, deepseek via openai-compatible)
LLM_BINDING=openai
LLM_MODEL=deepseek-chat
LLM_BINDING_API_KEY=your_key_here
LLM_BINDING_HOST=https://api.deepseek.com

# Embeddings
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BINDING_API_KEY=your_openai_key_here

# Database (if applicable)
MONGO_URI=mongodb://localhost:27017/deeptutor
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
