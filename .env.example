# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google API Key (OPTIONAL - for specific features)
VITE_GOOGLE_API_KEY=your-google-api-key-here

# HuggingFace Token (OPTIONAL - for AI insights feature)
# If not provided, AI insights button will be disabled
VITE_HUGGINGFACE_TOKEN=your-huggingface-token-here

# DeepTutor Configuration (OPTIONAL - defaults to localhost if not set)
VITE_DEEPTUTOR_URL=http://localhost:3782
VITE_DEEPTUTOR_API_URL=http://localhost:8001/api/v1
